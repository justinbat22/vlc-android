    <!--
        AMOLED overlay: forces the dark theme backgrounds to pure black.
        The home bottom bar background (@drawable/bottom_navigation_background_dark) is
        intentionally NOT overridden so it keeps its own colour.
    -->
    <style name="ThemeOverlay.VLC.Amoled" parent="">
        <item name="android:windowBackground">@color/black</item>
        <item name="background_default">@color/black</item>
        <item name="background_default_darker">@color/black</item>
        <item name="header_background">@color/black</item>
        <item name="background_actionbar">@color/black</item>
        <item name="card_background">@color/black</item>
        <item name="bottom_sheet_background">@color/black</item>
        <item name="tips_item_background">@color/black</item>
        <item name="empty_background">@color/black</item>
        <item name="audio_header_background">@color/black</item>
        <item name="background_audio_tips">@color/black</item>
        <item name="permission_explanation_background">@color/black</item>
        <item name="swipe_refresh_background">@color/black</item>
    </style>
