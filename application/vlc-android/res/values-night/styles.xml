<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.VLC"
        parent="Theme.VLC.Black" />


    <style name="VLCTransparentTheme" parent="VLCTransparentThemeDark"/>

    <style name="Toolbar.VLC" parent="ThemeOverlay.MaterialComponents.Toolbar.Surface">
        <item name="android:textCursorDrawable">@drawable/cursor_w</item>
        <item name="colorControlNormal">@color/grey400</item>
        <item name="popupMenuBackground">@color/grey875</item>
    </style>

    <style name="Theme.VLC.PickerDialog" parent="Theme.VLC.PickerDialog.Dark"/>

    <!--
        Dark variants of the interface accent overlays (see values/styles.xml).
        The brighter 500 shade is used on the dark background for readability.
    -->
    <style name="ThemeOverlay.VLC.Accent.Orange" parent="">
        <item name="colorPrimary">@color/accent_orange_500</item>
        <item name="colorPrimaryDark">@color/transparent</item>
        <item name="colorSecondary">@color/accent_orange_500</item>
        <item name="colorAccent">@color/accent_orange_500</item>
        <item name="colorControlHighlight">@color/accent_orange_500</item>
        <item name="colorOnSecondary">@color/grey50</item>
        <item name="primary_focus">@color/accent_orange_focus</item>
        <item name="bottom_navigation_focus">@color/accent_orange_ripple</item>
        <item name="audio_browser_separator">@color/accent_orange_500</item>
    </style>

